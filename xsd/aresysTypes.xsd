    <xs:attribute name="Number" type="xs:unsignedInt" use="optional" />
    <xs:attribute name="Total" type="xs:unsignedInt" use="optional" />
  </xs:complexType>
  <xs:simpleType name="AscendingDescendingType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ASCENDING" />
      <xs:enumeration value="DESCENDING" />
      <xs:enumeration value="NOT_AVAILABLE" />
    </xs:restriction>
  </xs:simpleType>
