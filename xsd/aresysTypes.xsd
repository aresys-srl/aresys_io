      <xs:enumeration value="s/s4" />
      <xs:enumeration value="s/s5" />
      <xs:enumeration value="Hz" />
      <xs:enumeration value="Hz/s" />
      <xs:enumeration value="Hz/s2" />
      <xs:enumeration value="Hz/s3" />
      <xs:enumeration value="Hz/s4" />
      <xs:enumeration value="Hz/s5" />
      <xs:enumeration value="Hz/s6" />
      <xs:enumeration value="Hz/s7" />
      <xs:enumeration value="Hz/s8" />
      <xs:enumeration value="Hz/s9" />
      <xs:enumeration value="rad/s" />
      <xs:enumeration value="rad/s2" />
      <xs:enumeration value="rad/s3" />
      <xs:enumeration value="rad/s4" />
      <xs:enumeration value="rad/s5" />
      <xs:enumeration value="rad/s6" />
      <xs:enumeration value="rad/s7" />
      <xs:enumeration value="rad/s8" />
      <xs:enumeration value="rad/s9" />
      <xs:enumeration value="s85" />
      <xs:enumeration value="Utc" />
      <xs:enumeration value="b" />
      <xs:enumeration value="K" />
      <xs:enumeration value="s/m" />
      <xs:enumeration value="s/m2" />
      <xs:enumeration value="s/m3" />
      <xs:enumeration value="s/m4" />
      <xs:enumeration value="s/m5" />
      <xs:enumeration value="s/m6" />
