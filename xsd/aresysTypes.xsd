      <xs:enumeration value="deg/s" />
      <xs:enumeration value="deg/s2" />
      <xs:enumeration value="deg/s3" />
      <xs:enumeration value="deg/s4" />
      <xs:enumeration value="deg/s5" />
      <xs:enumeration value="deg/s6" />
      <xs:enumeration value="deg/s7" />
      <xs:enumeration value="deg/s8" />
      <xs:enumeration value="deg/s9" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PolarizationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="H/H" />
      <xs:enumeration value="H/V" />
      <xs:enumeration value="V/H" />
      <xs:enumeration value="V/V" />
      <xs:enumeration value="X/X" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="GlobalPolarizationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SINGLE POL" />
      <xs:enumeration value="DUAL POL" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="LeftRightType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="LEFT" />
      <xs:enumeration value="RIGHT" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ReferenceFrameType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="GEOCENTRIC" />
      <xs:enumeration value="GEODETIC" />
      <xs:enumeration value="ZERODOPPLER" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RotationOrderType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="YPR" />
      <xs:enumeration value="YRP" />
      <xs:enumeration value="PRY" />
      <xs:enumeration value="PYR" />
      <xs:enumeration value="RPY" />
      <xs:enumeration value="RYP" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="AttitudeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NOMINAL" />
      <xs:enumeration value="REFINED" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ImageQuantityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="BETA" />
      <xs:enumeration value="GAMMA" />
      <xs:enumeration value="SIGMA" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="doubleWithUnit">
    <xs:simpleContent>
      <xs:extension base="xs:double">
        <xs:attribute name="unit" type="at:units" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="stringWithUnit">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="unit" type="at:units" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="PulseType">
    <xs:annotation>
      <xs:documentation>Transmitted pulse parameters</xs:documentation>
    </xs:annotation>
    <xs:complexContent mixed="false">
      <xs:extension base="at:TreeElementBaseType">
        <xs:all>
          <xs:element name="Direction" minOccurs="0">
            <xs:annotation>
              <xs:documentation>Pulse direction (UP, DOWN)</xs:documentation>
            </xs:annotation>
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="UP" />
                <xs:enumeration value="DOWN" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element name="PulseLength" type="at:doubleWithUnit">
            <xs:annotation>
              <xs:documentation>Pulse length [s]</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Bandwidth" type="at:doubleWithUnit">
            <xs:annotation>
              <xs:documentation>Pulse bandwidth [Hz]</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="PulseEnergy" type="at:doubleWithUnit">
            <xs:annotation>
              <xs:documentation>Pulse energy [J]</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="PulseSamplingRate" type="at:doubleWithUnit">
            <xs:annotation>
              <xs:documentation>Pulse sampling rate [Hz]</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="PulseStartFrequency" type="at:doubleWithUnit">
            <xs:annotation>
              <xs:documentation>Pulse start frequency [Hz]</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="PulseStartPhase" type="at:doubleWithUnit">
            <xs:annotation>
              <xs:documentation>Pulse start phase [rad]</xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="DataSetInfoType">
    <xs:annotation>
      <xs:documentation>Information regarding the dataset</xs:documentation>
    </xs:annotation>
    <xs:complexContent mixed="false">
      <xs:extension base="at:TreeElementBaseType">
        <xs:all>
          <xs:element name="SensorName" type="xs:string">
            <xs:annotation>
              <xs:documentation>Name of the sensor used to acquire the image: ASAR, PALSAR, ...</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Description">
            <xs:annotation>
              <xs:documentation>Description of the image</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:string">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="SenseDate">
            <xs:annotation>
              <xs:documentation>Image acquisition date</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:string">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="AcquisitionMode">
            <xs:annotation>
              <xs:documentation>Image acquisition mode: STRIPMAP, TOPSAR, ...</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:string">
                  <xs:attribute name="Polarization" type="at:GlobalPolarizationType" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="ImageType">
            <xs:annotation>
              <xs:documentation>Image type: RAW DATA, RANGE FOCUSED, AZIMUTH FOCUSED </xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:string">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="Projection">
            <xs:annotation>
              <xs:documentation>Image projection: SLANT RANGE, GROUND RANGE</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:string">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element minOccurs="0" name="ProjectionParameters">
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:string">
                  <xs:attribute name="Format" type="xs:string" use="required" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="ImageQuantity" type="at:ImageQuantityType" minOccurs="0" />
          <xs:element name="AcquisitionStation">
            <xs:annotation>
              <xs:documentation>Image acquisition station</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:string">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="ProcessingCenter">
            <xs:annotation>
              <xs:documentation>Image processing center</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:string">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="ProcessingDate">
            <xs:annotation>
              <xs:documentation>Image processing date</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:string">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="ProcessingSoftware">
            <xs:annotation>
              <xs:documentation>Image processing software</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:string">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="fc_hz">
            <xs:annotation>
              <xs:documentation>Radar carrier frequency [Hz]</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:double">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="SideLooking" type="at:LeftRightType">
            <xs:annotation>
              <xs:documentation>Radar side looking: LEFT, RIGHT</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="ExternalCalibrationFactor" type="xs:double">
            <xs:annotation>
              <xs:documentation>External calibration factor</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="DataTakeID" type="xs:unsignedInt" />
          <xs:element minOccurs="0" name="InstrumentConfID">
            <xs:simpleType>
              <xs:restriction base="xs:integer">
                <xs:minInclusive value="0" />
                <xs:maxInclusive value="99999999" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="StateVectorDataType">
    <xs:annotation>
      <xs:documentation>Information regarding position and velocity of the sensor along the orbit (State Vector Data)</xs:documentation>
    </xs:annotation>
    <xs:complexContent mixed="false">
      <xs:extension base="at:TreeElementBaseType">
        <xs:all>
          <xs:element name="OrbitNumber" type="xs:string">
            <xs:annotation>
              <xs:documentation>Number of the orbit</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="Track" type="xs:string">
            <xs:annotation>
              <xs:documentation>Number of the track</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="OrbitDirection">
            <xs:annotation>
              <xs:documentation>Direction of the orbit: ASCENDING, DESCENDING</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="at:AscendingDescendingType" />
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="pSV_m">
            <xs:annotation>
              <xs:documentation>Orbit state vectors position coordinates (xyz) [m]</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="val">
                  <xs:complexType>
                    <xs:simpleContent>
                      <xs:extension base="xs:double">
                        <xs:attribute name="N" type="xs:int" use="optional" />
                        <xs:attribute name="unit" type="at:units" use="optional" />
                      </xs:extension>
                    </xs:simpleContent>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="vSV_mOs">
            <xs:annotation>
              <xs:documentation>Orbit state vectors velocity coordinates [m/s]</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="val">
                  <xs:complexType>
                    <xs:simpleContent>
                      <xs:extension base="xs:double">
                        <xs:attribute name="N" type="xs:int" use="optional" />
                        <xs:attribute name="unit" type="at:units" use="optional" />
                      </xs:extension>
                    </xs:simpleContent>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="t_ref_Utc" type="xs:string">
            <xs:annotation>
              <xs:documentation>Azimuth absolute start time for the first state vector [Utc]</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="dtSV_s">
            <xs:annotation>
              <xs:documentation>Azimuth time interval between two consecutive state vectors [s]</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:double">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="nSV_n">
            <xs:annotation>
              <xs:documentation>Number of state vectors</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:int">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element minOccurs="0" name="AscendingNodeTime" type="xs:string">
            <xs:annotation>
              <xs:documentation>Azimuth absolute time of the ascending node</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element minOccurs="0" name="AscendingNodeCoords">
            <xs:annotation>
              <xs:documentation>Coordinates of the ascending node</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:element minOccurs="3" maxOccurs="3" name="val">
                  <xs:complexType>
                    <xs:simpleContent>
                      <xs:extension base="xs:double">
                        <xs:attribute name="N" type="xs:int" use="optional" />
                        <xs:attribute name="unit" type="at:units" use="optional" />
                      </xs:extension>
                    </xs:simpleContent>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:all>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="AttitudeInfoType">
    <xs:annotation>
      <xs:documentation>Sensor attitude information</xs:documentation>
    </xs:annotation>
    <xs:complexContent mixed="false">
      <xs:extension base="at:TreeElementBaseType">
        <xs:all>
          <xs:element name="t_ref_Utc" type="xs:string">
            <xs:annotation>
              <xs:documentation>Azimuth absolute start time for the first attitude value [Utc]</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="dtYPR_s">
            <xs:annotation>
              <xs:documentation>Azimuth time interval between two consecutive attitude values [s]</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:double">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="nYPR_n">
            <xs:annotation>
              <xs:documentation>Number of attitude values</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:int">
                  <xs:attribute name="unit" type="at:units" use="optional" />
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
          </xs:element>
          <xs:element name="yaw_deg">
            <xs:annotation>
              <xs:documentation>Yaw angle values [deg]</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="val">
                  <xs:complexType>
                    <xs:simpleContent>
                      <xs:extension base="xs:double">
                        <xs:attribute name="N" type="xs:int" use="optional" />
                        <xs:attribute name="unit" type="at:units" use="optional" />
                      </xs:extension>
                    </xs:simpleContent>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="pitch_deg">
            <xs:annotation>
              <xs:documentation>Pitch angle values [deg]</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="val">
                  <xs:complexType>
                    <xs:simpleContent>
                      <xs:extension base="xs:double">
                        <xs:attribute name="N" type="xs:int" use="optional" />
                        <xs:attribute name="unit" type="at:units" use="optional" />
                      </xs:extension>
                    </xs:simpleContent>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="roll_deg">
            <xs:annotation>
              <xs:documentation>Roll angle values [deg]</xs:documentation>
            </xs:annotation>
            <xs:complexType>
              <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="val">
                  <xs:complexType>
                    <xs:simpleContent>
                      <xs:extension base="xs:double">
                        <xs:attribute name="N" type="xs:int" use="optional" />
                        <xs:attribute name="unit" type="at:units" use="optional" />
                      </xs:extension>
                    </xs:simpleContent>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="referenceFrame" type="at:ReferenceFrameType">
            <xs:annotation>
              <xs:documentation>Reference frame: GEOCENTRIC, GEODETIC, ZERODOPPLER</xs:documentation>
