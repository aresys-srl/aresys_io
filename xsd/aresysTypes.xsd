<?xml version='1.0' encoding='utf-8'?>
<xs:schema xmlns:at="aresysTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="unqualified" targetNamespace="aresysTypes">
