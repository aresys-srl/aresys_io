  <xs:simpleType name="AcquisitionModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NOT SET" />
      <xs:enumeration value="STRIPMAP" />
      <xs:enumeration value="DOUBLE POL" />
      <xs:enumeration value="QUAD POL" />
      <xs:enumeration value="SCANSAR" />
      <xs:enumeration value="TOPSAR" />
      <xs:enumeration value="SPOT" />
      <xs:enumeration value="WAVE" />
      <xs:enumeration value="GMTI" />
